<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".SecondActivity">

    <TextView
        android:id="@+id/app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unit Converter"
        android:textSize="25sp"
        android:textColor="@color/primary_pink"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/historyButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:src="@drawable/baseline_history_24"
        android:padding="24dp"
        app:tint="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/searchArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/search_background"
        android:orientation="horizontal"
        android:layout_margin="10dp"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/app_name">

        <ImageView
            android:id="@+id/searchIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:layout_marginTop="5dp"
            app:tint="#B0B0B0"
            android:layout_marginStart="14dp" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Search unit"
            android:textColorHint="#B0B0B0"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/unitScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/searchArea"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="6"
            android:orientation="vertical"
            android:gravity="center">
            <LinearLayout
                android:id="@+id/length"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/unit_card_background">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_length"
                    app:tint="@color/primary_pink" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Length"
                    android:textSize="14sp"
                    android:textColor="@color/primary_pink" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/volume"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/unit_card_background">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_volume"
                    app:tint="@color/primary_pink" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Volume"
                    android:textSize="14sp"
                    android:textColor="@color/primary_pink" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/Time"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/unit_card_background">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_time"
                    app:tint="@color/primary_pink" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Time"
                    android:textSize="14sp"
                    android:textColor="@color/primary_pink" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/temperature"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/unit_card_background">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_temperature"
                    app:tint="@color/primary_pink" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Temperature"
                    android:textSize="14sp"
                    android:textColor="@color/primary_pink" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/energy"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/unit_card_background">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_energy"
                    app:tint="@color/primary_pink" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Energy"
                    android:textSize="14sp"
                    android:textColor="@color/primary_pink" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/weigth"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/unit_card_background">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_weigth"
                    app:tint="@color/primary_pink" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Weigth"
                    android:textSize="14sp"
                    android:textColor="@color/primary_pink" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/area"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/unit_card_background">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_area"
                    app:tint="@color/primary_pink" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Area"
                    android:textSize="14sp"
                    android:textColor="@color/primary_pink" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/mass"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/unit_card_background">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_mass"
                    app:tint="@color/primary_pink" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Mass"
                    android:textSize="14sp"
                    android:textColor="@color/primary_pink" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/speed"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/unit_card_background">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_speed"
                    app:tint="@color/primary_pink" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Speed"
                    android:textSize="14sp"
                    android:textColor="@color/primary_pink" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/density"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/unit_card_background">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_density"
                    app:tint="@color/primary_pink" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Density"
                    android:textSize="14sp"
                    android:textColor="@color/primary_pink" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/angle"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/unit_card_background">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_angle"
                    app:tint="@color/primary_pink" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Angle"
                    android:textSize="14sp"
                    android:textColor="@color/primary_pink" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/fuel"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/unit_card_background">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_fuel"
                    app:tint="@color/primary_pink" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Fuel"
                    android:textSize="14sp"
                    android:textColor="@color/primary_pink" />
            </LinearLayout>

        </GridLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>