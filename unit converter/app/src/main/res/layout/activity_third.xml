<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="16dp"
    tools:context=".ThirdActivity">
    <ImageButton
        android:id="@+id/backBtn"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:background="@drawable/unit_card_background"
        android:layout_margin="10dp"
        android:padding="15dp"
        android:src="@drawable/ic_back"
        app:tint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:text="Unit Converter"
        android:textColor="@color/primary_pink"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/backBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/backBtn"
        app:layout_constraintTop_toTopOf="@id/backBtn" />
    <TextView
        android:id="@+id/unitName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="10dp"
        android:text="Temperature"
        android:textColor="@color/primary_pink"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/backBtn" />
    <GridLayout
        android:id="@+id/converterGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:columnCount="2"
        android:rowCount="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/unitName">
        <EditText
            android:id="@+id/fromValue"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/unit_card_background"
            android:hint="From"
            android:inputType="numberDecimal|numberSigned"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:textColor="@color/white"
            android:textColorHint="@color/input_areas_text_color"
            android:textSize="18sp" />
        <EditText
            android:id="@+id/toValue"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/unit_card_background"
            android:cursorVisible="false"
            android:focusable="false"
            android:hint="To"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:textColor="@color/white"
            android:textColorHint="@color/input_areas_text_color"
            android:textIsSelectable="true"
            android:textSize="18sp" />
        <Spinner
            android:id="@+id/fromSpinner"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:layout_marginTop="15dp"
            android:layout_row="1"
            android:background="@drawable/unit_card_background"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
        <Spinner
            android:id="@+id/toSpinner"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:layout_marginTop="15dp"
            android:layout_row="1"
            android:background="@drawable/unit_card_background"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </GridLayout>

    <ImageButton
        android:id="@+id/switchBtn"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/image_background"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:src="@drawable/ic_convert"
        app:tint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/converterGrid" />

</androidx.constraintlayout.widget.ConstraintLayout>